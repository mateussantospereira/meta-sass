# =============================================================================
# MetaSass — variáveis de ambiente (docker-compose.yml lê este arquivo)
# Copie para .env e preencha: cp .env.example .env
# =============================================================================

# --- URL pública (o único domínio que o navegador conhece) --------------------
APP_PUBLIC_URL=https://mateus-pereira-isw055.lapps.studio

# --- MariaDB (mesmo banco para app e auth-service) ---------------------------
DB_HOST=35.226.64.52
DB_PORT=3306
DB_USER=IAC_2026_02_mateus_pereira
DB_PASSWORD=o1112oo6
DB_NAME=IAC_2026_02_mateus_pereira

# --- Segredos internos -------------------------------------------------------
# Gere valores próprios em produção: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=24h
INTERNAL_SYNC_TOKEN=
LOG_INGEST_TOKEN=

# --- Link de redefinição de senha --------------------------------------------
RESET_TOKEN_TTL_MINUTES=30

# --- E-mail (Mailtrap em desenvolvimento / Brevo em produção) ----------------
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=MetaSass

# --- Object storage (MinIO) --------------------------------------------------
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=metasass-midias

# --- Plano Pro (Stripe, sempre em modo de teste) ------------------------------
# Checkout hospedado pelo Stripe: nenhum dado de cartão passa pelo backend.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LABEL=R$ 29,00/mês
LIMITE_POSTS_GRATIS=5

# --- Instagram / Meta Graph API ----------------------------------------------
# Crie um app em https://developers.facebook.com/apps e copie as credenciais.
# Redirect URI cadastrada no app: https://SEU-DOMINIO/api/instagram/callback
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_GRAPH_VERSION=v22.0
# Chave que cifra o token da Página (AES-256-GCM) e assina OAuth state/URLs.
# NÃO troque depois de conectar contas: tokens antigos ficam ilegíveis.
APP_ENCRYPTION_KEY=

