{
  "name": "metasass",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MetaSass — planejamento, aprovação e publicação de conteúdo para Instagram e Facebook",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.28",
    "minio": "^8.0.7",
    "mysql2": "^3.23.3",
    "stripe": "^23.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3"
  }
}
